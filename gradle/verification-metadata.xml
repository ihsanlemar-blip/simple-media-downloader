<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="https://schema.gradle.org/dependency-verification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-8.0.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
   </configuration>
   <trusted-artifacts>
      <trust group=".*" regex="true" reason="Baseline configuration for reproducible build dependency resolution"/>
   </trusted-artifacts>
</configuration>
